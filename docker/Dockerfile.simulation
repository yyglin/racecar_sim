FROM osrf/ros:jazzy-desktop-noble

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

ARG DEBIAN_FRONTEND=noninteractive
ARG USERNAME=developer
ARG USER_UID=1000
ARG USER_GID=1000

# The Jazzy desktop image supplies RViz and the common GUI stack.  ros-gz on
# Jazzy installs the Gazebo Harmonic integration used by this workspace.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        ccache \
        gdb \
        git \
        less \
        mesa-utils \
        python3-colcon-common-extensions \
        python3-pip \
        python3-rosdep \
        python3-vcstool \
        ros-jazzy-joint-state-publisher \
        ros-jazzy-joint-state-publisher-gui \
        ros-jazzy-pcl-conversions \
        ros-jazzy-pcl-ros \
        ros-jazzy-robot-state-publisher \
        ros-jazzy-ros-gz \
        ros-jazzy-xacro \
        sudo \
    && rm -rf /var/lib/apt/lists/*

RUN existing_group="$(getent group "${USER_GID}" | cut -d: -f1 || true)" \
    && if [[ -z "${existing_group}" ]]; then \
         groupadd --gid "${USER_GID}" "${USERNAME}"; \
         existing_group="${USERNAME}"; \
       fi \
    && existing_user="$(getent passwd "${USER_UID}" | cut -d: -f1 || true)" \
    && if [[ -n "${existing_user}" && "${existing_user}" != "${USERNAME}" ]]; then \
         usermod --login "${USERNAME}" --home "/home/${USERNAME}" --move-home "${existing_user}"; \
       elif [[ -z "${existing_user}" ]]; then \
         useradd --uid "${USER_UID}" --gid "${existing_group}" --create-home --shell /bin/bash "${USERNAME}"; \
       fi \
    && usermod --gid "${existing_group}" --append --groups sudo "${USERNAME}" \
    && echo "${USERNAME} ALL=(ALL) NOPASSWD:ALL" > "/etc/sudoers.d/${USERNAME}" \
    && chmod 0440 "/etc/sudoers.d/${USERNAME}" \
    && printf '%s\n' \
         'source /opt/ros/jazzy/setup.bash' \
         '[[ -f /Fast_Segmentation_of_3D_Point_Clouds_for_Ground_Vehicles/Fast_Segmentation_ws/install/setup.bash ]] && source /Fast_Segmentation_of_3D_Point_Clouds_for_Ground_Vehicles/Fast_Segmentation_ws/install/setup.bash' \
         '[[ -f /Fast_Segmentation_of_3D_Point_Clouds_for_Ground_Vehicles/simulation_ws/install/setup.bash ]] && source /Fast_Segmentation_of_3D_Point_Clouds_for_Ground_Vehicles/simulation_ws/install/setup.bash' \
         >> "/home/${USERNAME}/.bashrc" \
    && chown "${USER_UID}:${USER_GID}" "/home/${USERNAME}/.bashrc" \
    && install -d -m 0700 -o "${USER_UID}" -g "${USER_GID}" /tmp/runtime-developer

ENV ROS_DISTRO=jazzy \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    HOME=/home/${USERNAME} \
    CCACHE_DIR=/home/${USERNAME}/.cache/ccache

WORKDIR /Fast_Segmentation_of_3D_Point_Clouds_for_Ground_Vehicles/simulation_ws
USER ${USERNAME}

CMD ["sleep", "infinity"]
