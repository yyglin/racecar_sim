<?xml version="1.0"?>
<sdf version="1.9">
  <model name="racecar">
    <!-- G4 keeps the vehicle fixed. G8 will enable dynamics and Ackermann steering. -->
    <static>true</static>
    <self_collide>false</self_collide>

    <link name="base_link">
      <pose>0 0 0.45 0 0 0</pose>
      <inertial>
        <mass>180.0</mass>
        <inertia>
          <ixx>16.35</ixx>
          <iyy>87.75</iyy>
          <izz>101.40</izz>
        </inertia>
      </inertial>

      <collision name="body_collision">
        <geometry>
          <box>
            <size>2.40 1.00 0.30</size>
          </box>
        </geometry>
      </collision>

      <visual name="body_visual">
        <geometry>
          <box>
            <size>2.40 1.00 0.30</size>
          </box>
        </geometry>
        <material>
          <ambient>0.03 0.12 0.28 1</ambient>
          <diffuse>0.04 0.28 0.75 1</diffuse>
          <specular>0.30 0.30 0.30 1</specular>
        </material>
      </visual>

      <visual name="nose_visual">
        <pose>1.38 0 -0.04 0 0 0</pose>
        <geometry>
          <box>
            <size>0.40 0.50 0.20</size>
          </box>
        </geometry>
        <material>
          <ambient>0.04 0.22 0.68 1</ambient>
          <diffuse>0.04 0.22 0.68 1</diffuse>
        </material>
      </visual>

      <visual name="roll_hoop_visual">
        <pose>-0.35 0 0.38 0 0 0</pose>
        <geometry>
          <box>
            <size>0.08 0.82 0.70</size>
          </box>
        </geometry>
        <material>
          <ambient>0.05 0.05 0.05 1</ambient>
          <diffuse>0.10 0.10 0.10 1</diffuse>
        </material>
      </visual>
    </link>

    <link name="front_left_wheel">
      <pose>0.775 0.67 0.225 0 0 0</pose>
      <inertial>
        <mass>4.0</mass>
        <inertia>
          <ixx>0.057</ixx>
          <iyy>0.101</iyy>
          <izz>0.057</izz>
        </inertia>
      </inertial>
      <collision name="collision">
        <pose>0 0 0 1.570796 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.225</radius>
            <length>0.14</length>
          </cylinder>
        </geometry>
      </collision>
      <visual name="visual">
        <pose>0 0 0 1.570796 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.225</radius>
            <length>0.14</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.03 0.03 0.03 1</ambient>
          <diffuse>0.05 0.05 0.05 1</diffuse>
        </material>
      </visual>
    </link>

    <link name="front_right_wheel">
      <pose>0.775 -0.67 0.225 0 0 0</pose>
      <inertial>
        <mass>4.0</mass>
        <inertia>
          <ixx>0.057</ixx>
          <iyy>0.101</iyy>
          <izz>0.057</izz>
        </inertia>
      </inertial>
      <collision name="collision">
        <pose>0 0 0 1.570796 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.225</radius>
            <length>0.14</length>
          </cylinder>
        </geometry>
      </collision>
      <visual name="visual">
        <pose>0 0 0 1.570796 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.225</radius>
            <length>0.14</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.03 0.03 0.03 1</ambient>
          <diffuse>0.05 0.05 0.05 1</diffuse>
        </material>
      </visual>
    </link>

    <link name="rear_left_wheel">
      <pose>-0.775 0.67 0.225 0 0 0</pose>
      <inertial>
        <mass>4.0</mass>
        <inertia>
          <ixx>0.057</ixx>
          <iyy>0.101</iyy>
          <izz>0.057</izz>
        </inertia>
      </inertial>
      <collision name="collision">
        <pose>0 0 0 1.570796 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.225</radius>
            <length>0.14</length>
          </cylinder>
        </geometry>
      </collision>
      <visual name="visual">
        <pose>0 0 0 1.570796 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.225</radius>
            <length>0.14</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.03 0.03 0.03 1</ambient>
          <diffuse>0.05 0.05 0.05 1</diffuse>
        </material>
      </visual>
    </link>

    <link name="rear_right_wheel">
      <pose>-0.775 -0.67 0.225 0 0 0</pose>
      <inertial>
        <mass>4.0</mass>
        <inertia>
          <ixx>0.057</ixx>
          <iyy>0.101</iyy>
          <izz>0.057</izz>
        </inertia>
      </inertial>
      <collision name="collision">
        <pose>0 0 0 1.570796 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.225</radius>
            <length>0.14</length>
          </cylinder>
        </geometry>
      </collision>
      <visual name="visual">
        <pose>0 0 0 1.570796 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.225</radius>
            <length>0.14</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.03 0.03 0.03 1</ambient>
          <diffuse>0.05 0.05 0.05 1</diffuse>
        </material>
      </visual>
    </link>

    <link name="lidar_link">
      <pose>0.15 0 1.18 0 0 0</pose>
      <inertial>
        <mass>1.0</mass>
        <inertia>
          <ixx>0.0024</ixx>
          <iyy>0.0024</iyy>
          <izz>0.0032</izz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry>
          <cylinder>
            <radius>0.08</radius>
            <length>0.10</length>
          </cylinder>
        </geometry>
      </collision>
      <visual name="visual">
        <geometry>
          <cylinder>
            <radius>0.08</radius>
            <length>0.10</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.04 0.04 0.04 1</ambient>
          <diffuse>0.10 0.10 0.10 1</diffuse>
        </material>
      </visual>

      <sensor name="top_lidar" type="gpu_lidar">
        <topic>/lidar</topic>
        <gz_frame_id>lidar_link</gz_frame_id>
        <update_rate>10</update_rate>
        <always_on>true</always_on>
        <visualize>true</visualize>

        <lidar>
          <scan>
            <horizontal>
              <samples>720</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159265</min_angle>
              <max_angle>3.14159265</max_angle>
            </horizontal>
            <vertical>
              <samples>32</samples>
              <resolution>1</resolution>
              <min_angle>-0.436332</min_angle>
              <max_angle>0.261799</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.3</min>
            <max>50.0</max>
            <resolution>0.02</resolution>
          </range>
        </lidar>
      </sensor>
    </link>

    <joint name="front_left_wheel_fixed_joint" type="fixed">
      <parent>base_link</parent>
      <child>front_left_wheel</child>
    </joint>
    <joint name="front_right_wheel_fixed_joint" type="fixed">
      <parent>base_link</parent>
      <child>front_right_wheel</child>
    </joint>
    <joint name="rear_left_wheel_fixed_joint" type="fixed">
      <parent>base_link</parent>
      <child>rear_left_wheel</child>
    </joint>
    <joint name="rear_right_wheel_fixed_joint" type="fixed">
      <parent>base_link</parent>
      <child>rear_right_wheel</child>
    </joint>
    <joint name="lidar_fixed_joint" type="fixed">
      <parent>base_link</parent>
      <child>lidar_link</child>
    </joint>
  </model>
</sdf>
