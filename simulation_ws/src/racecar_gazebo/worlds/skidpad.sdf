<?xml version="1.0"?>
<sdf version="1.9">
  <world name="skidpad">
    <!--
      Formula Student Germany 2026 D4 / Figure 21:
        two concentric-circle pairs in a figure eight;
        centres at (-9.125, 0) and (9.125, 0), 18.25 m apart;
        inner diameter 15.25 m and outer diameter 21.25 m;
        3.00 m path between the nominal circle markings;
        17 cones inside each inner circle and 13 cones outside each outer circle.
      The nominal white markings use radii 7.625 m and 10.625 m.
      Cone centres are offset away from the driving path: 7.50 m and 10.75 m.
      Entry and exit use the vertical 3 m tangent path shown in Figure 21.
      Cone colours are approximate and do not affect the FSG geometry.
    -->
    <physics name="default_physics" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.75 0.85 0.95 1</background>
      <shadows>true</shadows>
    </scene>

    <light type="directional" name="sun">
      <pose>0 0 30 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.2 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="ground_link">
        <collision name="ground_collision">
          <geometry><plane><normal>0 0 1</normal><size>100 60</size></plane></geometry>
          <surface><friction><ode><mu>1.2</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="ground_visual">
          <geometry><plane><normal>0 0 1</normal><size>100 60</size></plane></geometry>
          <material>
            <ambient>0.22 0.22 0.22 1</ambient>
            <diffuse>0.30 0.30 0.30 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="skidpad_markings">
